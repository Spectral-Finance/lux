{
  "name": "Lux (Elixir/Phoenix)",
  "image": "mcr.microsoft.com/devcontainers/elixir:1-20",
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "forwardPorts": [4000],
  "portsRemap": {
    "4000": "4000"
  },
  "postCreateCommand": "cd lux && mix deps.get && mix compile",
  "customizations": {
    "vscode": {
      "settings": {
        "\"elixirLS.dialyzerEnabled\"": true,
        "\"elixirLS.fetchDeps\": false,
        "[elixir]": {
          "editor.defaultFormatter": "JakeBecker.elixir-ls"
        }
      },
      "extensions": [
        "JakeBecker.elixir-ls",
        "phoenixframework.phoenix-snippets",
        "montes Brennan.vscode-credo"
      ]
    }
  }
}
